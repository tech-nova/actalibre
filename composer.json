{
    "name": "actalibre/actalibre",
    "version": "1.2.0",
    "description": "ActaLibre : publication d'actes généalogiques (fork d'ExpoActes)",
    "type": "project",
    "license": "GPL-2.0-only",
    "require": {
        "php": ">=8.3",
        "ext-filter": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*",
        "ext-mysqlnd": "*",
        "ext-session": "*",
        "ext-xml": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12",
        "rector/rector": "^2.8"
    },
    "suggest": {
        "ext-curl": "Permet le contrôle HTTP des protections Apache.",
        "ext-openssl": "Permet le géocodage de la carte via HTTPS."
    },
    "extra": {
        "actalibre": {
            "schema": "1.0.0"
        }
    },
    "autoload": {
        "psr-4": {
            "ActaLibre\\": "src/ActaLibre/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ActaLibre\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": [
            "phpstan analyse -c tests/Analyse/phpstan.neon --no-progress --memory-limit=2G",
            "phpstan analyse -c tests/Analyse/phpstan-src.neon --no-progress --memory-limit=2G"
        ],
        "rector-simulation": "rector process --config tests/Analyse/rector.php --dry-run --no-progress-bar"
    },
    "config": {
        "sort-packages": true
    }
}
